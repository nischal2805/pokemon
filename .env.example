# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Long random secret for JWT signing (e.g. openssl rand -hex 32)
JWT_SECRET=changeme_long_random_secret

# Your public domain (e.g. DuckDNS subdomain)
DOMAIN=yourpokeserver.duckdns.org

# Invite code required for registration (leave empty to disable)
INVITE_CODE=yourcode

# Maximum registered users allowed
MAX_USERS=20
